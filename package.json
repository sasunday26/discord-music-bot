{
	"name": "discord-music-bot",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "node src/index.ts",
		"dev": "node --env-file-if-exists=.env --watch src/index.ts",
		"register-commands": "node --env-file-if-exists=.env src/scripts/register-commands.ts",
		"typecheck": "tsc",
		"lint": "biome check",
		"format": "biome check --write",
		"test": "vitest run"
	},
	"dependencies": {
		"discord-api-types": "^0.38.60",
		"discord.js": "^14.28.1",
		"shoukaku": "^4.3.0"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
